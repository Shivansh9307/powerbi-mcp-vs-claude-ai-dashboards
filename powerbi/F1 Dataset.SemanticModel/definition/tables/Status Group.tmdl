	partition 'Status Group' = calculated
		mode: import
		source = DATATABLE("Status Group", STRING, "Group Order", INTEGER, "Counts as DNF", STRING, "Rule", STRING, {{"Finished", 1, "No", "Status Finished on the lead lap"}, {"Lapped", 2, "No", "Classified but one or more laps down (+N Lap)"}, {"Mechanical DNF", 3, "Yes", "Retired with a car failure: engine, gearbox, hydraulics, electrics, tyres and the rest"}, {"Accident DNF", 4, "Yes", "Accident, collision, spun off, damage, debris"}, {"Other DNF", 5, "Yes", "Retired, not classified, withdrew, injury, illness, safety"}, {"Disqualified", 6, "No", "Position code D or E, or a disqualification, exclusion or underweight status"}, {"Did not start", 7, "No", "Position code F or W: did not qualify, did not prequalify, 107% rule, withdrawn"}})

