/// Points scored by each constructor in each race (constructors' championship contribution). Grain: one row per constructor per race.
table 'Constructor Results'
	lineageTag: 3f7afb72-51e1-4402-aac4-0794291827d1

	/// Points a constructor scored across its drivers in the selected races.
	measure 'Constructor Points' = SUM('Constructor Results'[Points])
		formatString: General Number
		displayFolder: Points
		lineageTag: d62ae117-c150-4798-827c-a50a4039e53c

	column 'Race Id'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 817c973c-a61e-46a0-824c-d99604d1bd79
		summarizeBy: none
		sourceColumn: Race Id

	column 'Constructor Id'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e382dfc4-f6be-4e4f-ac1b-a836126c8eb3
		summarizeBy: none
		sourceColumn: Constructor Id

	/// Points the constructor scored in this race.
	column Points
		dataType: decimal
		isHidden
		formatString: #,##0.##
		lineageTag: 880585f6-999b-427f-9d52-cc9e77c13137
		summarizeBy: sum
		sourceColumn: Points

	partition 'Constructor Results' = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents(#"F1 CSV Folder" & "\constructor_results.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				  Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				  Cleaned = Table.ReplaceValue(Promoted, "\N", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				  Selected = Table.SelectColumns(Cleaned, {"raceId", "constructorId", "points"}),
				  Renamed = Table.RenameColumns(Selected, {{"raceId", "Race Id"}, {"constructorId", "Constructor Id"}, {"points", "Points"}}),
				  Typed = Table.TransformColumnTypes(Renamed, {{"Race Id", Int64.Type}, {"Constructor Id", Int64.Type}, {"Points", Currency.Type}}, "en-US")
				in
				  Typed

	annotation PBI_ResultType = Table

