/// Qualifying session results (Q1, Q2, Q3). Grain: one row per driver per race weekend.
table Qualifying
	lineageTag: 4fd9001b-3c26-4bfb-9655-d46bfd5917fb

	/// Qualifying results with a recorded lap time.
	measure 'Qualifying Entries' = COUNTROWS(FILTER('Qualifying', NOT ISBLANK('Qualifying'[Best Qualifying Time (ms)])))
		formatString: #,##0
		displayFolder: Qualifying
		lineageTag: bb9d07a3-ae66-4690-9693-b5984b332a5b

	/// Sessions in which the driver or team was fastest in qualifying. Can differ from Pole Positions, which uses the race grid after penalties.
	measure 'Quali Poles' = CALCULATE(COUNTROWS('Qualifying'), 'Qualifying'[Qualifying Position] = 1)
		formatString: #,##0
		displayFolder: Qualifying
		lineageTag: fad3de00-5483-49f7-8f70-4fba39726d12

	/// Mean percentage by which qualifying laps were slower than the session's fastest lap. Lower is closer to pole.
	measure 'Avg Gap to Fastest (%)' = AVERAGE('Qualifying'[Gap to Fastest (%)])
		formatString: 0.00%
		displayFolder: Qualifying
		lineageTag: bbc891b6-8ee3-426a-b8ac-81cd7bb37d1e

	/// Qualifying sessions in which the driver set a Q3 time (three-session format, from 2006 in this data).
	measure 'Reached Q3' = CALCULATE(COUNTROWS('Qualifying'), NOT ISBLANK('Qualifying'[Q3 (ms)]))
		formatString: #,##0
		displayFolder: Qualifying
		lineageTag: 9df01f96-14ab-495a-a6f5-94a66ee7919a

	/// Rank of each driver by qualifying poles in the current selection.
	measure 'Quali Poles Rank' = IF([Quali Poles] > 0, RANKX(ALLSELECTED('Driver'[Driver]), [Quali Poles], , DESC, Skip))
		formatString: 0
		isHidden
		displayFolder: Helpers
		lineageTag: a5e95acd-347c-41f8-958c-a9cfa58f2300

	/// Coverage note for qualifying visuals.
	measure 'Quali Coverage Message' =
			VAR _n = COUNTROWS(FILTER(VALUES('Season'[Season]), CALCULATE(COUNTROWS('Qualifying')) > 0))
			VAR _first = MINX('Qualifying', RELATED('Race'[Season Year]))
			RETURN IF(COALESCE(_n, 0) = 0, "No qualifying records in these seasons. They start in 1994 and are partial in the early years.", "Qualifying records cover " & _n & " seasons in view, from " & _first & " (partial in the early years).")
		formatString: @
		displayFolder: Messages
		lineageTag: 3777b5e9-ca37-4733-9981-48f30e7fc146

	column 'Race Id'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b6d2e0a8-1378-4feb-9ea8-3fce12165a9e
		summarizeBy: none
		sourceColumn: Race Id

	column 'Driver Id'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 97aba77e-4d47-4554-912e-e3a8047e7a13
		summarizeBy: none
		sourceColumn: Driver Id

	column 'Constructor Id'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0754e2d1-7412-4421-bb0b-c93bfacb3134
		summarizeBy: none
		sourceColumn: Constructor Id

	/// Final qualifying position, which sets the starting grid before penalties.
	column 'Qualifying Position'
		dataType: int64
		formatString: 0
		lineageTag: ff6760f1-aac0-4627-9f06-a2337d863635
		summarizeBy: none
		sourceColumn: Qualifying Position

	/// Best lap in the first qualifying session as m:ss.000 text. Blank if no time set.
	column 'Q1 Time'
		dataType: string
		lineageTag: 2208034b-a8a0-40d9-9d67-6f9253b5d16f
		summarizeBy: none
		sourceColumn: Q1 Time

	/// Best lap in the second session. Blank for drivers eliminated in Q1 and for races before the three-session format.
	column 'Q2 Time'
		dataType: string
		lineageTag: 3efa054c-bac7-487c-8900-f42d4b3c69ca
		summarizeBy: none
		sourceColumn: Q2 Time

	/// Best lap in the final session. Blank for drivers eliminated earlier.
	column 'Q3 Time'
		dataType: string
		lineageTag: fb026f80-726c-4cfd-9f5e-c1b4129c4047
		summarizeBy: none
		sourceColumn: Q3 Time

	/// Best lap in the first session in milliseconds. Blank when not set.
	column 'Q1 (ms)'
		dataType: int64
		formatString: #,##0
		lineageTag: 1f430271-d5cc-4fb3-b46c-ddbc9fbaf239
		summarizeBy: none
		sourceColumn: Q1 (ms)

	/// Best lap in the second session in milliseconds. Blank when not reached.
	column 'Q2 (ms)'
		dataType: int64
		formatString: #,##0
		lineageTag: 26117e5f-be25-43e3-bbe0-b738e98b4935
		summarizeBy: none
		sourceColumn: Q2 (ms)

	/// Best lap in the third session in milliseconds. Blank when not reached.
	column 'Q3 (ms)'
		dataType: int64
		formatString: #,##0
		lineageTag: a73b6cf7-ee4a-4369-9c3c-5799d457bf2c
		summarizeBy: none
		sourceColumn: Q3 (ms)

	/// Fastest of the driver's Q1, Q2 and Q3 laps in milliseconds. Blank when no time was set.
	column 'Best Qualifying Time (ms)'
		dataType: int64
		formatString: #,##0
		lineageTag: 383f5003-36e6-4ccb-b896-0b5c21ee7228
		summarizeBy: none
		sourceColumn: Best Qualifying Time (ms)

	/// Qualifying results with millisecond lap times.
	/// Fastest qualifying lap of the whole session in milliseconds.
	column 'Session Fastest (ms)' =
			VAR _r = 'Qualifying'[Race Id]
			RETURN MINX(FILTER('Qualifying', 'Qualifying'[Race Id] = _r), 'Qualifying'[Best Qualifying Time (ms)])
		dataType: int64
		formatString: #,##0
		lineageTag: 0b18262d-1000-43b9-ad7f-01863c7285bf
		summarizeBy: none

	/// Driver's best qualifying lap as a percentage slower than the session's fastest lap. Zero for the pole sitter.
	column 'Gap to Fastest (%)' = IF(ISBLANK('Qualifying'[Best Qualifying Time (ms)]), BLANK(), DIVIDE('Qualifying'[Best Qualifying Time (ms)], 'Qualifying'[Session Fastest (ms)]) - 1)
		dataType: double
		formatString: 0.00%
		lineageTag: bbeb0044-a3a1-47ca-9e89-8414251abb62
		summarizeBy: none

	partition Qualifying = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents(#"F1 CSV Folder" & "\qualifying.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				  Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				  Cleaned = Table.ReplaceValue(Promoted, "\N", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				  Selected = Table.SelectColumns(Cleaned, {"raceId", "driverId", "constructorId", "position", "q1", "q2", "q3"}),
				  Renamed = Table.RenameColumns(Selected, {{"raceId", "Race Id"}, {"driverId", "Driver Id"}, {"constructorId", "Constructor Id"}, {"position", "Qualifying Position"}, {"q1", "Q1 Time"}, {"q2", "Q2 Time"}, {"q3", "Q3 Time"}}),
				  Typed = Table.TransformColumnTypes(Renamed, {{"Race Id", Int64.Type}, {"Driver Id", Int64.Type}, {"Constructor Id", Int64.Type}, {"Qualifying Position", Int64.Type}, {"Q1 Time", type text}, {"Q2 Time", type text}, {"Q3 Time", type text}}, "en-US"),
				  ToMs = (t as nullable text) as nullable number => if t = null or t = "" then null else let parts = Text.Split(t, ":"), m = Number.FromText(parts{0}, "en-US"), s = Number.FromText(parts{1}, "en-US") in Number.Round((m * 60 + s) * 1000, 0),
				  Q1 = Table.AddColumn(Typed, "Q1 (ms)", each ToMs([Q1 Time]), Int64.Type),
				  Q2 = Table.AddColumn(Q1, "Q2 (ms)", each ToMs([Q2 Time]), Int64.Type),
				  Q3 = Table.AddColumn(Q2, "Q3 (ms)", each ToMs([Q3 Time]), Int64.Type),
				  Best = Table.AddColumn(Q3, "Best Qualifying Time (ms)", each List.Min({[#"Q1 (ms)"], [#"Q2 (ms)"], [#"Q3 (ms)"]}), Int64.Type)
				in
				  Best

	annotation PBI_ResultType = Table

