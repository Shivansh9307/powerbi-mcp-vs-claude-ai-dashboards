/// Constructors' championship standings after each race. Grain: one row per constructor per race. Standings are cumulative, so do not sum across races.
table 'Constructor Standings'
	lineageTag: 8f09d56c-a162-455d-8538-ca1c72807cd6

	/// Constructors' championship points after the most recent race in the current selection. For a season this is the final tally. Cumulative, so it is not summed across races.
	measure 'Latest Constructor Points' =
			VAR _lastRaceDate = CALCULATE(MAXX('Constructor Standings', RELATED('Race'[Race Date])), REMOVEFILTERS('Circuit'))
			RETURN
			    CALCULATE(SUM('Constructor Standings'[Championship Points]), 'Race'[Race Date] = _lastRaceDate, REMOVEFILTERS('Circuit'))
		formatString: General Number
		displayFolder: Standings
		lineageTag: 5b1bd9f4-67a7-48f2-8bbf-7896ff1f459d

	/// Constructors' championship position after the most recent race in the current selection. For a season this is the final classification (1 = champion).
	measure 'Latest Constructor Position' =
			VAR _lastRaceDate = CALCULATE(MAXX('Constructor Standings', RELATED('Race'[Race Date])), REMOVEFILTERS('Circuit'))
			RETURN
			    CALCULATE(MIN('Constructor Standings'[Championship Position]), 'Race'[Race Date] = _lastRaceDate, REMOVEFILTERS('Circuit'))
		formatString: 0
		displayFolder: Standings
		lineageTag: 7b2e40e6-46e5-44f9-af1d-ee72bc000934

	/// World Constructors' Championships won, counted only for completed seasons. The constructors' title has existed since 1958. Select a constructor for that team's titles.
	measure 'Constructor Titles' = SUMX(VALUES('Season'[Season]), IF(CALCULATE(MAX('Season'[Complete Flag])) = 1 && [Latest Constructor Position] = 1, 1))
		formatString: #,##0
		displayFolder: Standings
		lineageTag: 09a5ac2b-aa05-4413-91e6-1ea560d8f971

	/// Name of the constructor in first place after the latest race in the selection. Followed by (leader) while the season is in progress. Shows Not awarded for seasons before 1958, when the title did not exist.
	measure 'Constructors'' Champion' =
			VAR _champion = MAXX(FILTER(VALUES('Constructor'[Constructor]), [Latest Constructor Position] = 1), 'Constructor'[Constructor])
			RETURN IF(NOT ISBLANK(_champion), _champion & IF(CALCULATE(MIN('Season'[Complete Flag])) = 0, " (leader)", ""), IF(MAX('Season'[Season]) < 1958, "Not awarded"))
		formatString: @
		displayFolder: Season
		lineageTag: b1ee9b16-5f0e-4631-a420-62480da18cfc

	column 'Race Id'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 532be9e2-a8b2-4fe1-a5eb-355f4379a5ca
		summarizeBy: none
		sourceColumn: Race Id

	column 'Constructor Id'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5fb318d3-47dc-464f-b5e9-933eead84cf4
		summarizeBy: none
		sourceColumn: Constructor Id

	/// Cumulative constructor points for the season after this race.
	column 'Championship Points'
		dataType: decimal
		isHidden
		formatString: #,##0.##
		lineageTag: 582d1952-0138-4be4-bff3-efd5786a0a61
		summarizeBy: none
		sourceColumn: Championship Points

	/// Position in the constructors' championship after this race.
	column 'Championship Position'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 45856c40-3b20-4760-9055-076c4011463a
		summarizeBy: none
		sourceColumn: Championship Position

	/// Cumulative race wins in the season after this race.
	column 'Season Wins'
		dataType: int64
		formatString: 0
		lineageTag: 0d73cb08-901f-46c9-bd1a-f12d450652a3
		summarizeBy: none
		sourceColumn: Season Wins

	partition 'Constructor Standings' = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents(#"F1 CSV Folder" & "\constructor_standings.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				  Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				  Cleaned = Table.ReplaceValue(Promoted, "\N", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				  Selected = Table.SelectColumns(Cleaned, {"raceId", "constructorId", "points", "position", "wins"}),
				  Renamed = Table.RenameColumns(Selected, {{"raceId", "Race Id"}, {"constructorId", "Constructor Id"}, {"points", "Championship Points"}, {"position", "Championship Position"}, {"wins", "Season Wins"}}),
				  Typed = Table.TransformColumnTypes(Renamed, {{"Race Id", Int64.Type}, {"Constructor Id", Int64.Type}, {"Championship Points", Currency.Type}, {"Championship Position", Int64.Type}, {"Season Wins", Int64.Type}}, "en-US")
				in
				  Typed

	annotation PBI_ResultType = Table

